# Copy to .env.local and fill in. NEVER commit a real .env — .gitignore already
# excludes .env and .env*.local, and it must stay that way.

# --- Database -------------------------------------------------------------
# Direct PostgreSQL connection used by src/shared/db. Not the PostgREST URL.
#
# Local development with the Supabase CLI (`npx supabase start`, needs Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
#
# Supabase hosted: Project Settings → Database → Connection string → URI.
# Use the *session* pooler on Vercel; the transaction pooler does not support
# the session-scoped locks reservation depends on.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connections held per serverless instance. Keep small on a free tier.
DATABASE_POOL_MAX=5

# --- Supabase (auth and storage) -----------------------------------------
# Safe in the browser. RLS is what protects the data behind the anon key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely. Never expose to the client, never prefix
# with NEXT_PUBLIC_, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests ----------------------------------------------------------------
# Optional. Unset, the integration suite starts its own throwaway PostgreSQL.
# Set it to run against an existing server instead. See TESTING.md.
# PACHKA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
