# Copy to .env.local and fill in. NEVER commit a real .env — .gitignore already
# excludes .env and .env*.local, and it must stay that way.

# --- Database -------------------------------------------------------------
# Direct PostgreSQL connection used by src/shared/db. Not the PostgREST URL.
#
# THE ROLE MATTERS. This connection is subject to row-level security like any
# other, and every server-side write is permitted by a policy written
# `to service_role` in db/migrations. So the role here must be granted
# `service_role` (Supabase's own `postgres` already is). It does NOT need
# BYPASSRLS, and giving it BYPASSRLS is not a fix for a permission error — that
# error means a table is missing a grant or a write policy, and the integration
# suite runs as a non-superuser precisely so that it fails here first. See
# ARCHITECTURE.md, "Every table needs write policies".
#
# Local development with the Supabase CLI (`npx supabase start`, needs Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
#
# Supabase hosted: Project Settings → Database → Connection string → URI.
# Use the *session* pooler on Vercel; the transaction pooler does not support
# the session-scoped locks reservation depends on.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connections held per serverless instance. Keep small on a free tier.
DATABASE_POOL_MAX=5

# --- Supabase (auth and storage) -----------------------------------------
# Safe in the browser. RLS is what protects the data behind the anon key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS entirely. Never expose to the client, never prefix
# with NEXT_PUBLIC_, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mail (Resend) --------------------------------------------------------
# Transactional email: checkout payment instructions, notify-me confirmations,
# payout notices, and the operator's new-report alert. Both variables are
# OPTIONAL and unset is a supported state.
#
# UNSET IS NOT SILENT. With no key, src/shared/mail selects a logging adapter:
# it records every message and returns success, so development needs no mail
# account and a missing key can never fail a checkout. It also warns once at
# startup and reports `configured: false` from `mailHealth()`. Deploying to
# production with these blank means nobody is ever told anything — including
# the operator, whose complaint queue then depends on someone remembering to
# look at it. Check `mailHealth()` after a deploy.
#
# Sign up at resend.com (free tier: 3,000 emails/month, 100/day at the time of
# writing — enough for launch), then API Keys -> Create. Sending permission is
# all this needs; it never reads. The key is server-only: it must never be
# prefixed with NEXT_PUBLIC_ and never logged.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The fixed platform sender. Required whenever RESEND_API_KEY is set — a key
# with no sender selects the logging adapter and says why.
#
# THE DOMAIN MUST BE VERIFIED IN RESEND FIRST (Domains -> Add Domain, then the
# SPF and DKIM records it gives you, at your DNS host). Without verification
# Resend refuses everything except its own onboarding@resend.dev sandbox
# address, which only delivers to the account owner — a deployment that looks
# wired and reaches no buyer. Add a DMARC record too: PACHKA's mail is the
# thing an attacker most wants to forge.
#
# This is the ONLY place a sender is set. SECURITY.md S2-21 item 5: no
# user-supplied value ever populates any address header, and the ports carry a
# recipient and nothing else, so there is nowhere else one could come from.
# Either form works: bare address, or a display name in front.
# MAIL_FROM=PACHKA <hello@pachka.co.il>

# --- Tests ----------------------------------------------------------------
# Optional. Unset, the integration suite starts its own throwaway PostgreSQL.
# Set it to run against an existing server instead. See TESTING.md.
# PACHKA_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- AI providers ---------------------------------------------------------
# Two providers, two accounts, and one call each per uploaded artwork. Neither
# is ever reached by a buyer-triggered request: ARCHITECTURE.md's hard rule is
# that AI spend scales with the number of ARTWORKS, never with traffic, so a
# thousand artworks costs a few dollars once and a million catalog views cost
# nothing.

# Anthropic (console.anthropic.com -> API keys). Claude Haiku 4.5 does the one
# vision call per uploaded image: taxonomy suggestions, dominant colours, the
# safety verdict and the description, all in a single response. About $0.003
# per image at current Haiku rates — roughly $3 per thousand artworks, once.
#
# WITHOUT THIS KEY THE SITE STILL RUNS AND PUBLISHES NOTHING. There is no
# "screening disabled in development" branch anywhere in `uploads`, because
# that branch is a security hole: SECURITY.md S0-7 requires that no image reach
# a public surface without a successful screening verdict, and an unreachable
# screening service is attacker-triggerable. So with no key every upload is
# accepted into the artist's draft, flagged for admin review, and refused
# publication until the key is set. That is loud and recoverable. The
# alternative — publishing unscreened images — is neither.
ANTHROPIC_API_KEY=

# Voyage AI (dash.voyageai.com -> API keys). Anthropic has no embeddings API,
# and Voyage is Anthropic's own documented recommendation. `voyage-3` returns
# 1024 dimensions, which is what `artwork_embeddings.embedding` is declared as
# — the provider was chosen to fit the column, not the other way round, because
# changing a stored vector's width invalidates every embedding already written.
# About $0.000015 per artwork: a rounding error next to the vision call.
#
# Without this key the site publishes normally. Artworks are browsable in the
# catalog and absent from matchmaker results until an embedding exists, which
# is exactly what `upload-pipeline` specifies for an embedding failure. The
# matchmaker never calls this provider at all — it builds a buyer's query
# vector from the vectors already stored here.
VOYAGE_API_KEY=
